{
  "name": "ordini-elly-edition-windows",
  "version": "1.2.7",
  "description": "Gestione ordini - Pannello di controllo Windows",
  "main": "dist/main.js",
  "author": "Elly Edition",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/OrangoTanga/ordini-elle-edition.git"
  },
  "scripts": {
    "dev": "npm run dev:kill-5173 && concurrently -k \"npm run dev:main\" \"npm run dev:renderer\" \"npm run dev:electron\"",
    "dev:main": "tsc -p tsconfig.main.json --watch",
    "dev:renderer": "vite --port 5173 --strictPort",
    "dev:electron": "cp src/main/preload.js dist/ && VITE_DEV_SERVER_URL=http://localhost:5173 electron .",
    "dev:kill-5173": "lsof -ti tcp:5173 | xargs kill -9 2>/dev/null; exit 0",
    "build": "tsc -p tsconfig.main.json && cp src/main/preload.js dist/ && vite build",
    "start": "electron .",
    "icons": "node scripts/generate-icons.js",
    "dist": "node scripts/build-installer.js",
    "dist:portable": "node scripts/build-installer.js --portable",
    "dist:dir": "node scripts/build-installer.js --dir",
    "pack": "npm run build && electron-builder --win=dir",
    "release": "npm run build && electron-builder --win=nsis"
  },
  "dependencies": {
    "@imgly/background-removal": "^1.7.0",
    "@phosphor-icons/react": "^2.1.10",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "exceljs": "^4.4.0",
    "express": "^4.18.2",
    "googleapis": "^134.0.0",
    "jsonwebtoken": "^9.0.2",
    "socket.io": "^4.7.4",
    "socket.io-client": "^4.7.4",
    "sql.js": "^1.14.1",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/react": "^18.2.48",
    "@types/react-dom": "^18.2.18",
    "@types/sql.js": "^1.4.11",
    "@types/uuid": "^9.0.7",
    "@vitejs/plugin-react": "^4.2.1",
    "concurrently": "^8.2.2",
    "electron": "^28.1.0",
    "electron-builder": "^24.9.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "typescript": "^5.3.3",
    "vite": "^5.0.12"
  },
  "build": {
    "appId": "com.elly-edition.ordini",
    "productName": "Ordini Elly Edition",
    "copyright": "Copyright © 2024 Elly Edition",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "legalTrademarks": "Elly Edition",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "installerHeader": "assets/icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Ordini Elly Edition",
      "uninstallDisplayName": "Ordini Elly Edition",
      "runAfterFinish": true,
      "warningsAsErrors": false,
      "deleteAppDataOnUninstall": true
    },
    "extraResources": [
      {
        "from": "assets/",
        "to": "assets/",
        "filter": [
          "**/*"
        ]
      }
    ]
  }
}
